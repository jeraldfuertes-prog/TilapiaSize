APP_NAME=TilapiaSize API
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/tilapiasize
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?$
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
